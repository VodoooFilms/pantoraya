{
  "name": "pantoraya",
  "version": "1.3.0",
  "description": "Private, offline MP4, MP3, JPG conversion for macOS, Windows and Linux",
  "main": "src/main/main.js",
  "desktopName": "pantoraya.desktop",
  "author": {
    "name": "VodoooFilms",
    "email": "toniom75@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/VodoooFilms/pantoraya#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VodoooFilms/pantoraya.git"
  },
  "bugs": {
    "url": "https://github.com/VodoooFilms/pantoraya/issues"
  },
  "keywords": [
    "macos",
    "windows",
    "linux",
    "ffmpeg",
    "mp4",
    "mp3",
    "jpg",
    "offline",
    "converter"
  ],
  "scripts": {
    "build:ffmpeg": "node scripts/build-ffmpeg.js",
    "prepare:engines": "node scripts/prepare-engines.js",
    "prepare:windows": "node scripts/prepare-windows.js",
    "prepare:linux": "node scripts/prepare-linux.js",
    "prestart": "npm run prepare:engines",
    "start": "electron .",
    "check": "node --check src/main/main.js && node --check src/preload/preload.js && node --check src/renderer/app.js && node --check scripts/build-ffmpeg.js && node --check scripts/prepare-engines.js && node --check scripts/prepare-windows.js && node --check scripts/prepare-linux.js",
    "test": "node --test",
    "prebuild": "npm run prepare:engines",
    "build": "npm run check && npm test && electron-builder --mac dmg --arm64",
    "build:win": "npm run prepare:windows && npm run check && npm test && electron-builder --win nsis --x64",
    "build:win:dir": "npm run prepare:windows && npm run check && npm test && electron-builder --win dir --x64",
    "build:linux": "npm run prepare:linux && npm run check && npm test && electron-builder --linux deb --x64",
    "build:linux:dir": "npm run prepare:linux && npm run check && npm test && electron-builder --linux dir --x64",
    "prebuild:dir": "npm run prepare:engines",
    "build:dir": "npm run check && npm test && electron-builder --mac dir --arm64"
  },
  "build": {
    "appId": "com.pantoraya.converter",
    "productName": "Pantoraya",
    "artifactName": "Pantoraya-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/after-pack.js",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icons/pantoraya.icns",
      "minimumSystemVersion": "13.4",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "extraResources": [
        {
          "from": "build/licenses",
          "to": "licenses"
        },
        {
          "from": "build/ffmpeg/ffmpeg",
          "to": "ffmpeg/ffmpeg"
        },
        {
          "from": "assets/icons/pantoraya.png",
          "to": "icons/pantoraya.png"
        },
        {
          "from": "assets/locales/en.lproj/InfoPlist.strings",
          "to": "en.lproj/InfoPlist.strings"
        },
        {
          "from": "assets/locales/es.lproj/InfoPlist.strings",
          "to": "es.lproj/InfoPlist.strings"
        }
      ],
      "extendInfo": {
        "CFBundleName": "Pantoraya",
        "CFBundleDisplayName": "Pantoraya",
        "NSDesktopFolderUsageDescription": "Pantoraya necesita acceder a tu Escritorio para abrir archivos, mostrar miniaturas y guardar conversiones.",
        "NSDocumentsFolderUsageDescription": "Pantoraya necesita acceder a Documentos para abrir archivos, mostrar miniaturas y guardar conversiones.",
        "NSDownloadsFolderUsageDescription": "Pantoraya necesita acceder a Descargas para abrir archivos, mostrar miniaturas y guardar conversiones.",
        "NSHumanReadableCopyright": "Copyright © 2026 Pantoraya"
      }
    },
    "win": {
      "icon": "assets/icons/pantoraya.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "build/licenses",
          "to": "licenses"
        },
        {
          "from": "build/windows/ffmpeg.exe",
          "to": "ffmpeg/ffmpeg.exe"
        }
      ]
    },
    "linux": {
      "category": "AudioVideo",
      "icon": "assets/icons/pantoraya.png",
      "syncDesktopName": true,
      "target": [
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "ffmpeg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pantoraya",
      "uninstallDisplayName": "Pantoraya"
    },
    "dmg": {
      "title": "Pantoraya ${version}",
      "icon": "assets/icons/pantoraya.icns",
      "iconSize": 128,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "extract-zip": "^2.0.1"
  }
}
