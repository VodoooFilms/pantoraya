{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pantoraya",
  "version": "1.3.0",
  "identifier": "com.pantoraya.converter",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pantoraya",
        "width": 410,
        "height": 400,
        "minWidth": 410,
        "minHeight": 400,
        "maxWidth": 410,
        "maxHeight": 400,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.4"
    }
  }
}
